#!/usr/bin/env bash
# Configures nginx to run as the nginx user and listen on port 8080
sed -Ei 's/^#?\s*user\s+.*;/user nginx;/' /etc/nginx/nginx.conf
sed -Ei 's/(listen\s+(\[::\]:)?)80\b/\18080/g' /etc/nginx/sites-enabled/default
chmod 644 /etc/nginx/nginx.conf
pkill apache2
pkill nginx
su -s /bin/bash nginx -c 'service nginx start'
