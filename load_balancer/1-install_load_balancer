#!/usr/bin/env bash
# Installs and configures HAProxy to load balance web-01 and web-02 (roundrobin)

sudo apt-get update -y
sudo apt-get install -y haproxy

# Allow HAProxy to be managed by its init script
echo "ENABLED=1" | sudo tee /etc/default/haproxy > /dev/null

# Write the HAProxy configuration
sudo tee /etc/haproxy/haproxy.cfg > /dev/null << 'EOF'
global
	log /dev/log local0
	log /dev/log local1 notice
	chroot /var/lib/haproxy
	stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
	stats timeout 30s
	user haproxy
	group haproxy
	daemon
	h1-case-adjust x-served-by X-Served-By

defaults
	log global
	mode http
	option httplog
	option dontlognull
	timeout connect 5000
	timeout client 50000
	timeout server 50000

frontend http_front
	bind *:80
	option h1-case-adjust-bogus-client
	default_backend web_servers

backend web_servers
	balance roundrobin
	server 7336-web-01 18.175.143.138:80 check
	server 7336-web-02 3.8.8.209:80 check
EOF

# Check the configuration, then enable and restart HAProxy
sudo haproxy -c -f /etc/haproxy/haproxy.cfg
sudo systemctl enable haproxy
sudo service haproxy restart

# Give HAProxy a moment to start, then show which server answers
sleep 5
for _ in 1 2 3 4; do
	curl -sI localhost | grep X-Served-By
done
