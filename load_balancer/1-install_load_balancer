#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 to balance traffic between web-01 and web-02 (roundrobin)

sudo apt-get update -y
sudo apt-get install -y haproxy

# Let the init script manage HAProxy (needed on older Ubuntu releases)
if [ -f /etc/default/haproxy ]; then
    sudo sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
fi

# Write the HAProxy configuration
sudo tee /etc/haproxy/haproxy.cfg > /dev/null << 'EOF'
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    h1-case-adjust x-served-by X-Served-By

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    option h1-case-adjust-bogus-client
    default_backend http_back

backend http_back
    balance roundrobin
    server 7336-web-01 18.175.143.138:80 check
    server 7336-web-02 3.8.8.209:80 check
EOF

# Enable at boot and restart through the init script
sudo systemctl enable haproxy 2> /dev/null
sudo service haproxy restart
